#!/usr/bin/env bash
# sysres - agent-agnostic system resource check for the WSL agent home.
#
# Lightweight, POSIX bash. Reads /proc and /sys directly (near-zero subprocess
# cost) before heavy or parallel work so an AI agent gets a clear go/caution/
# block signal. Available on PATH to every agent harness (Claude Code, Codex,
# opencode, Pi) and to interactive shells.
#
# Usage:
#   sysres            human-readable block + VERDICT
#   sysres -j         single JSON object (machine-readable)
#   sysres -q         one compact line
#   sysres -h         this help
#   sysres --version
#
# Exit codes: 0 = all green (safe to launch), 1 = amber (proceed with caution),
#             2 = red (do not launch heavy work now), 255 = internal error.
#
# Thresholds default in-script; override per KEY in ~/.config/sysres.conf.
set -u

export LC_ALL=C
export LANG=C

PROG="sysres"
VERSION="1.0.0"
CONF="${SYSRES_CONF:-$HOME/.config/sysres.conf}"

# ---- defaults (override in $CONF) -----------------------------------------
mem_amber=80   # % used where memory turns amber
mem_red=92     # % used where memory turns red
cpu_amber=1.0  # 1-min load / cores where load turns amber
cpu_red=1.5    # 1-min load / cores where load turns red
disk_amber=85  # % used where disk turns amber
disk_red=93    # % used where disk turns red
fd_amber=80    # % of FD headroom used where it turns amber
fd_red=90      # % of FD headroom used where it turns red

# ---- grade helpers ---------------------------------------------------------
worst=green     # overall verdict (green < amber < red)
GOT=0           # did any dimension actually resolve? (else: cannot tell)
grade() {       # grade <value> <amber> <red>  -> prints green|amber|red
  local v="$1" a="$2" r="$3"
  if awk -v v="$v" -v r="$r" 'BEGIN{exit !(v>=r)}'; then echo red
  elif awk -v v="$v" -v a="$a" 'BEGIN{exit !(v>=a)}'; then echo amber
  else echo green; fi
}
note() {        # roll up a dimension grade into the overall verdict
  case "$1" in
    red)   worst=red ;;
    amber) [ "$worst" = "green" ] && worst=amber ;;
  esac
}

# ---- config override -------------------------------------------------------
if [ -r "$CONF" ]; then
  while IFS='=' read -r k v; do
    [ -z "$k" ] && continue
    case "$k" in
      mem_amber|mem_red|cpu_amber|cpu_red|disk_amber|disk_red|fd_amber|fd_red)
        case "$v" in
          ''|*[!0-9.]*) ;;                       # ignore non-numeric
          *) eval "$k=$v" ;;
        esac ;;
    esac
  done < "$CONF"
fi

# ---- flags -----------------------------------------------------------------
MODE=human     # human | json | quiet
for a in "$@"; do
  case "$a" in
    -j|--json)    MODE=json ;;
    -q|--quiet)   MODE=quiet ;;
    -h|--help)    MODE=help ;;
    --version)    echo "$PROG $VERSION"; exit 0 ;;
    *)            MODE=help ;;
  esac
done

if [ "$MODE" = "help" ]; then
  cat <<EOF
$PROG $VERSION - system resource check for agents (WSL/Linux)

Checks four dimensions (memory, CPU load, disk, open FDs) and reports a
green|amber|red verdict plus a machine-checkable exit code.

Usage: $PROG [-j|-q|-h|--version]

  (no flag)   human-readable block + VERDICT line
  -j, --json  single JSON object on stdout
  -q, --quiet one compact line
  -h, --help  this help
  --version   print version

Exit codes: 0 = green (safe to launch heavy work)
            1 = amber (proceed with caution / one task at a time)
            2 = red   (do not launch heavy work now)
            255 = internal error

Thresholds (override in ~/.config/sysres.conf):
  mem_amber=$mem_amber%  mem_red=$mem_red%    (memory used %)
  cpu_amber=$cpu_amber   cpu_red=$cpu_red     (load / cores)
  disk_amber=$disk_amber% disk_red=$disk_red% (disk used %)
  fd_amber=$fd_amber%    fd_red=$fd_red%      (FD headroom used %)

Available to Claude Code, Codex, opencode, and Pi via the bash tool.
EOF
  exit 0
fi

# ---- collect data ----------------------------------------------------------
# memory: /proc/meminfo (single read, no `free` subprocess)
mem_total=""; mem_avail=""; MEM_UNKNOWN=0
if [ -r /proc/meminfo ]; then
  mem_total=$(awk '/^MemTotal:/{print $2}' /proc/meminfo)
  mem_avail=$(awk '/^MemAvailable:/{print $2}' /proc/meminfo)
fi
[ -n "$mem_total" ] && [ "$mem_total" -gt 0 ] || MEM_UNKNOWN=1
[ -n "$mem_avail" ] || MEM_UNKNOWN=1

mem_used=0; mem_pct=""; mem_grade="unknown"
if [ "$MEM_UNKNOWN" -eq 0 ]; then
  mem_used=$(( mem_total - mem_avail ))
  mem_pct=$(( mem_used * 100 / mem_total ))
  mem_grade=$(grade "$mem_pct" "$mem_amber" "$mem_red")
  note "$mem_grade"
  GOT=1
fi

# cpu: /proc/loadavg field 1 / cores (cores from /sys, nproc as fallback)
LOAD1=""; cores=0; CPU_UNKNOWN=1
if [ -r /proc/loadavg ]; then
  LOAD1=$(awk '{print $1}' /proc/loadavg)
fi
if [ -d /sys/devices/system/cpu ]; then
  cores=$(grep -c '^processor' /proc/cpuinfo 2>/dev/null)
  [ "$cores" -gt 0 ] || cores=$(find /sys/devices/system/cpu -maxdepth 1 -name 'cpu[0-9]*' 2>/dev/null | wc -l)
fi
[ "$cores" -gt 0 ] || cores=$(nproc 2>/dev/null || echo 1)
[ -n "$LOAD1" ] && [ "$cores" -ge 1 ] && CPU_UNKNOWN=0

cpu_ratio=""; cpu_load=""; cpu_grade="unknown"
if [ "$CPU_UNKNOWN" -eq 0 ]; then
  cpu_ratio=$(awk -v l="$LOAD1" -v c="$cores" 'BEGIN{printf "%.6f", l/c}')
  cpu_load=$(awk -v r="$cpu_ratio" 'BEGIN{printf "%.1f", r}')
  cpu_grade=$(grade "$cpu_ratio" "$cpu_amber" "$cpu_red")
  note "$cpu_grade"
  GOT=1
fi

# disk: df -P on / and the cwd's filesystem (POSIX layout, no wrap).
# /mnt/* (WSL Windows drives over 9p) are surfaced as cheap rows but never
# block on a slow network mount and are not exhaustively scanned by default.
root_pct=""; root_avail=""; DISK_UNKNOWN=1
disk_rows=""
while IFS= read -r line; do
  [ -z "$line" ] && continue
  set -- $line
  [ "$#" -lt 6 ] && continue
  fs="$1"; sz="$2"; used="$3"; avail="$4"; usedpct="$5"; mnt="$6"
  usedpct=${usedpct%\%}
  case "$mnt" in
    /mnt/*) disk_rows="${disk_rows}\n$mnt ${usedpct}% (mount $fs)"; continue ;;  # not in verdict
  esac
  if [ "$mnt" = "/" ]; then root_pct="$usedpct"; root_avail="$avail"; DISK_UNKNOWN=0; fi
done < <(df -P / 2>/dev/null | tail -n +2)

disk_grade="unknown"
if [ "$DISK_UNKNOWN" -eq 0 ]; then
  disk_grade=$(grade "$root_pct" "$disk_amber" "$disk_red")
  note "$disk_grade"
  GOT=1
fi

# fds: /proc/sys/fs/file-nr is "allocated unused maximum" - max is field 3.
alloc=""; sysmax=""; FD_UNKNOWN=1
if [ -r /proc/sys/fs/file-nr ]; then
  read -r alloc unused_slots sysmax < /proc/sys/fs/file-nr 2>/dev/null || true
fi
softlimit=$(ulimit -n 2>/dev/null || echo 1024)
if [ -n "$sysmax" ] && [ "$sysmax" -gt 0 ] 2>/dev/null; then FD_UNKNOWN=0; fi

fd_pct=""; fd_grade="unknown"
if [ "$FD_UNKNOWN" -eq 0 ]; then
  fd_pct=$(( alloc * 100 / sysmax ))
  fd_grade=$(grade "$fd_pct" "$fd_amber" "$fd_red")
  note "$fd_grade"
  GOT=1
fi

# ---- exit code from overall verdict ----------------------------------------
if [ "$GOT" -eq 0 ]; then worst=unknown; EXIT=255; fi
case "$worst" in
  green) EXIT=0 ;;
  amber) EXIT=1 ;;
  red)   EXIT=2 ;;
  *)     EXIT=255 ;;
esac

# ---- output -----------------------------------------------------------------
# na: echo a value or "n/a" helper for quiet/human text when a metric is unresolved
na() { [ -n "$1" ] && printf '%s' "$1" || printf 'n/a'; }

if [ "$MODE" = "json" ]; then
  jnum() { # echo a number or null
    local v="$1"; [ -n "$v" ] && echo "$v" || echo null
  }
  jstr() { # echo a quoted string or null
    local v="$1"; [ -n "$v" ] && printf '"%s"' "$v" || printf 'null'
  }
  printf '{"verdict":"%s","exit_code":%d,' "$worst" "$EXIT"
  printf '"memory":{"used_pct":%s,"available_kb":%s,"total_kb":%s,"grade":%s},' \
    "$(jnum "$mem_pct")" "$(jnum "$mem_avail")" "$(jnum "$mem_total")" "$(jstr "$mem_grade")"
  printf '"cpu":{"load1":%s,"cores":%s,"normalized":%s,"grade":%s},' \
    "$(jnum "$LOAD1")" "$(jnum "$cores")" "$(jnum "$cpu_load")" "$(jstr "$cpu_grade")"
  printf '"disk":{"root_used_pct":%s,"root_avail_blocks":%s,"grade":%s},' \
    "$(jnum "$root_pct")" "$(jnum "$root_avail")" "$(jstr "$disk_grade")"
  printf '"fds":{"allocated":%s,"max":%s,"used_pct":%s,"soft_limit":%s,"grade":%s}' \
    "$(jnum "$alloc")" "$(jnum "$sysmax")" "$(jnum "$fd_pct")" "$(jnum "$softlimit")" "$(jstr "$fd_grade")"
  printf '}\n'
  exit "$EXIT"
fi

if [ "$MODE" = "quiet" ]; then
  printf 'mem %s%% | cpu %s/%s | disk / %s%% | fds %s/%s | %s\n' \
    "$(na "$mem_pct")" "$(na "$cpu_load")" "$(na "$cores")" "$(na "$root_pct")" \
    "$(na "$alloc")" "$(na "$sysmax")" "$worst"
  exit "$EXIT"
fi

# human
printf '%s\n' "sysres $VERSION - system resources"
printf '%s\n' "memory:  used $(na "$mem_pct")% ($(na "$mem_avail") KB free of $(na "$mem_total") KB)  [$mem_grade]"
printf '%s\n' "cpu:     load $(na "$LOAD1")/1min across $(na "$cores") cores (norm $(na "$cpu_load"))  [$cpu_grade]"
printf '%s\n' "disk:    / $(na "$root_pct")% used ($(na "$root_avail") blocks avail)  [$disk_grade]"
printf '%s\n' "fds:     $(na "$alloc")/$(na "$sysmax") alloc/max (soft $(na "$softlimit"))  [$fd_grade]"
if [ -n "$disk_rows" ]; then
  printf '%s\n' "other mounts (info only, not in verdict):"
  printf '%b\n' "$disk_rows" | sed '/^$/d' | sed 's/^/  /'
fi
printf 'VERDICT: %s (exit %d)\n' "$worst" "$EXIT"
exit "$EXIT"